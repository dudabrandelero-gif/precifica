rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA DO PRECIFICA
//
// Como aplicar: console.firebase.google.com → seu projeto → Firestore Database
// → aba "Regras" → cole este arquivo inteiro no lugar do que estiver lá →
// "Publicar".
//
// O que essas regras garantem:
// - Cada usuário só lê e escreve os PRÓPRIOS dados
//   (users/{uid}, users/{uid}/modelos/* e resumos/{uid}).
// - Não existe mais um papel "mentor" com acesso aos dados de outras contas —
//   por enquanto, o Precifica é só a calculadora, sem o painel de acompanhar
//   turma. Se essa funcionalidade voltar, é aqui que a permissão de leitura
//   extra seria adicionada de novo.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /modelos/{modelKey} {
        allow read, write: if isOwner(uid);
      }
    }

    match /resumos/{uid} {
      allow read, write: if isOwner(uid);
    }
  }
}
