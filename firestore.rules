rules_version = '2';

// ============================================================================
// REGRAS DE SEGURANÇA DO PRECIFICA
//
// Como aplicar: console.firebase.google.com → projeto Precifica (precifica-924da) →
// Firestore Database → aba "Regras" → apague o que estiver lá, cole este
// arquivo inteiro → "Publicar".
//
// O que essas regras garantem:
// - O acesso é livre: qualquer pessoa que cria conta usa o Precifica.
// - Cada pessoa só lê e escreve os PRÓPRIOS dados.
// - As administradoras (lista abaixo, com e-mail confirmado) leem os dados
//   de todo mundo e gerenciam a lista de convidados ("credenciados").
//
// A lista de administradoras precisa ser IGUAL à do app.js (ADMIN_EMAILS).
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true &&
        request.auth.token.email in [
          'mariaeduarda@archettiodonto.com.br',
          'ubiratan@archettiodonto.com.br'
        ];
    }

    // Lista de convidados (quem a equipe cadastrou). Só as administradoras mexem.
    match /credenciados/{email} {
      allow read, write: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /modelos/{modelKey} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // Números resumidos de cada pessoa (o que aparece no painel "Alunos").
    match /resumos/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid);
    }
  }
}
